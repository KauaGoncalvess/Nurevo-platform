# Conexão de OWNER — usada APENAS por migrations e pelo Prisma CLI.
# Este role é dono das tabelas e pode alterar schema.
DATABASE_URL="postgresql://nurevo_owner:owner_password@localhost:5432/nurevo?schema=public"

# Conexão da APLICAÇÃO — usada em runtime e nos testes.
# Role sem BYPASSRLS e sem SUPERUSER. É o que faz o RLS do doc 01 valer.
# NUNCA aponte a aplicação para DATABASE_URL.
DATABASE_URL_APP="postgresql://nurevo_app:app_password@localhost:5432/nurevo?schema=public"

# Conexão ADMIN — role COM BYPASSRLS. Enxerga todos os tenants.
# Só billing jobs e painel interno. O lint impede o uso em qualquer outro lugar.
DATABASE_URL_ADMIN="postgresql://nurevo_admin:admin_password@localhost:5432/nurevo?schema=public"

NODE_ENV="development"
PORT=3333
APP_URL="http://localhost:3000"

# Assina os access tokens (HS256). Em produção: 32+ bytes aleatórios, um por
# ambiente. Trocar o segredo invalida todos os access tokens em circulação.
JWT_SECRET="troque-isto-em-producao-com-openssl-rand-base64-32"

# Access token curto de propósito: permissão revogada só vale de verdade quando
# o token expira. Refresh longo com rotação e detecção de reuso (doc 03, tabela 3).
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
