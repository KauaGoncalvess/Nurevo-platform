{
  "name": "@nurevo/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "reset": "prisma migrate reset --force",
    "seed": "tsx scripts/seed.ts",
    "check:boundaries": "tsx scripts/check-schema-boundaries.ts",
    "studio": "prisma studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@nurevo/eslint-config": "workspace:*",
    "@nurevo/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.0",
    "prisma": "^6.19.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
